# Server Settings
PROJECT_NAME="BlindViz 2.0 API"
VERSION="2.0.0"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# CORS & Security
ALLOWED_ORIGINS=["*"]

# Storage Locations
UPLOAD_DIR="uploads"
LOG_DIR="logs"

# YOLOv8 Settings
YOLO_MODEL_PATH="models/yolov8n.pt"
YOLO_CONF_THRESHOLD=0.45

# OCR Settings
OCR_LANGUAGES=["en"]
OCR_USE_GPU=False

# Vision LLM Settings
OPENAI_API_KEY="your-openai-api-key-here"
LLM_MODEL_NAME="gpt-4-vision-preview"

# Speech Settings
TTS_DEFAULT_VOICE="en"
WHISPER_MODEL_SIZE="base"
